rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if ownsUser(uid);

      // New accounts must start with a zero balance.
      allow create: if ownsUser(uid)
        && request.resource.data.uid == uid
        && request.resource.data.balance == 0
        && request.resource.data.currency == 'BRL'
        && request.resource.data.status == 'active';

      // Clients cannot change balances or mining sessions.
      allow update, delete: if false;
    }

    match /depositRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.status == 'pending'
        && request.resource.data.reference is string
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }

    match /withdrawalRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.status == 'pending'
        && request.resource.data.reference is string
        && request.resource.data.recipientName is string
        && request.resource.data.bankName is string
        && request.resource.data.accountNumber is string
        && request.resource.data.pixKey is string
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }

    // Deny access to every other collection by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
